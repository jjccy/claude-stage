{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "rootDir": ".",
    "outDir": ".",
    "sourceMap": false,
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["hooks/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
