{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "rootDir": "hooks",
    "outDir": "out/hooks",
    "sourceMap": false,
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["hooks/**/*.ts"],
  "exclude": ["node_modules"]
}
